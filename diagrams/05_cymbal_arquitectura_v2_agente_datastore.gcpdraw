# Cymbal Health v2.0 (PR #1 Desplegado): Agente Clinico ADK, Vertex AI Search Data Store y Defensa 5 Anillos
# Evolucion segura sobre v1.0 con RAG de protocolos CUPS, Cloud SQL SELECT-only y Model Armor + DLP (<30ms).

meta {
  title "Cymbal Health v2.0: Agente Clinico ADK, Vertex AI Search Data Store y Defensa IA en 5 Anillos"
}

elements {
  card laptop_and_phone as medico_v2 {
    name "Personal Medico"
    display_name "Modal Asistente IA"
  }

  gcp {
    group perimetro_tier1_v2 {
      name "Perimetro WAF y Tier 1 (v2.0)"
      background_color "#E8F0FE"

      card armor as alb_waf_v2 {
        name "Global ALB + Cloud Armor"
        display_name "TLS + OWASP WAF"
      }
      stacked_card run as portal_v2 {
        name "cymbal-health-web-portal"
        display_name "Cloud Run v2.0 (UID 10001)"
      }
      card iam as sa_portal_v2 {
        name "cymbal-health-portal-sa"
        display_name "OIDC Invoker + GCS RW"
      }
    }

    group tier2_agentic_v2 {
      name "Tier 2 Interno: Agente ADK y MCP"
      background_color "#E6F4EA"

      stacked_card run as agent_v2 {
        name "cymbal-health-clinical-agent"
        display_name "Cloud Run + Google ADK"
      }
      card iam as sa_agent_v2 {
        name "cymbal-health-agent-sa"
        display_name "Keyless ADC (0% Keys)"
      }
      card run as mcp_v2 {
        name "cymbal-health-backlog-mcp"
        display_name "Cloud Run MCP Interno"
      }
    }

    group guardrails_rag_v2 {
      name "Defensa 5 Anillos y Dual Datastore"
      background_color "#FEF7E0"

      card data_loss_prevention as ma_dlp_v2 {
        name "Model Armor + Cloud DLP"
        display_name "Prompt + RAG Scan <30ms"
      }
      card ai_platform as vais_datastore {
        name "Vertex AI Search"
        display_name "clinical-protocols-ds"
      }
      card vertex_ai as gemini_v2 {
        name "Vertex AI Gemini"
        display_name "Tools Tipadas ADK"
      }
      card sql as sql_ro_v2 {
        name "Cloud SQL PostgreSQL 15"
        display_name "clinical_orders_public_v"
      }
      card storage as gcs_dual_v2 {
        name "Buckets GCS Privados"
        display_name "Soportes PDF y Guias"
      }
    }

    group gov_secops_v2 {
      name "Gobernanza, SecOps y CDR"
      background_color "#F3E8FD"

      card ai_hub as registry_v2 {
        name "Agent Registry"
        display_name "Catalogo ADK y MCP"
      }
      card logging as logging_v2 {
        name "Cloud Audit Logs"
        display_name "traceId y callerIp"
      }
      card security_command_center as secops_wiz_v2 {
        name "Google SecOps + Wiz"
        display_name "UDM SIEM y CDR"
      }
    }
  }
}

paths {
  # Entrada HTTPS hacia WAF y Portal v2.0
  medico_v2 -right-> alb_waf_v2 : "HTTPS"
  alb_waf_v2 -down-> portal_v2
  portal_v2 .down.> sa_portal_v2

  # Salto interno autenticado con OIDC hacia Tier 2 ADK
  portal_v2 -right-> agent_v2
  agent_v2 .down.> sa_agent_v2
  sa_agent_v2 (-down->) mcp_v2

  # Defensa en 5 anillos: Model Armor + DLP, Vertex AI Search RAG, Gemini y SQL SELECT-only
  agent_v2 -right-> ma_dlp_v2
  ma_dlp_v2 -down-> vais_datastore
  vais_datastore -down-> gemini_v2
  gemini_v2 (-down->) sql_ro_v2
  sql_ro_v2 (-down->) gcs_dual_v2

  sa_agent_v2 .right.> sql_ro_v2
  sa_portal_v2 .right.> gcs_dual_v2

  # Registro gobernado y telemetria forense hacia SecOps y Wiz Cloud
  ma_dlp_v2 .right.> registry_v2
  vais_datastore .right.> logging_v2
  registry_v2 (-down->) logging_v2
  logging_v2 -down-> secops_wiz_v2
}
