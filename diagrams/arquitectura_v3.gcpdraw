# Cymbal Health v3: Arquitectura Web + Agente IA Seguro

meta {
  title "Cymbal Health Arquitectura: Web + Agente IA Seguro"
}

elements {
  card laptop_and_phone as usuarios_v3 {
    name "Usuarios"
    display_name "Navegador HTTPS"
  }

  gcp {
    group perimetro_v3 {
      name "Perimetro Global"
      background_color "#E8F0FE"

      card load_balancer as lb_v3 {
        name "Load Balancer"
        display_name "HTTPS Global"
      }
      card armor as waf_v3 {
        name "Cloud Armor"
        display_name "WAF OWASP"
      }
    }

    group app_v3 {
      name "Aplicacion"
      background_color "#E6F4EA"

      stacked_card run as portal_v3 {
        name "Web Portal"
        display_name "Cloud Run"
      }
      card iam as sa_portal_v3 {
        name "Service Account"
        display_name "Least Privilege"
      }
    }

    group ops_v3 {
      name "Monitoreo"
      background_color "#F3E8FD"

      card logging as logs_v3 {
        name "Audit Logs"
        display_name "Cloud Logging"
      }
    }

    group datos_v3 {
      name "Red y Datos Privados"
      background_color "#FEF7E0"

      card vpc as vpc_v3 {
        name "Private VPC"
        display_name "Red Aislada"
      }
      card sql as db_v3 {
        name "Orders DB"
        display_name "Cloud SQL PostgreSQL"
      }
      card storage as pdf_v3 {
        name "PDF Storage"
        display_name "Cloud Storage"
      }
    }

    group agent_layer_v3 {
      name "Agente IA Interno"
      background_color "#E8F0FE"

      stacked_card run as agent_v3 {
        name "Clinical Agent"
        display_name "Cloud Run + ADK"
      }
      card iam as sa_agent_v3 {
        name "Agent Identity"
        display_name "Least Privilege"
      }
      card ai_hub as registry_v3 {
        name "Agent Registry"
        display_name "Catalogo IA"
      }
    }

    group ai_security_v3 {
      name "Seguridad IA y Conocimiento"
      background_color "#FEF7E0"

      card data_loss_prevention as guardrails_v3 {
        name "Model Armor + DLP"
        display_name "Anti-Injection y PII"
      }
      card vertex_ai as gemini_v3 {
        name "Gemini Model"
        display_name "Vertex AI"
      }
      card ai_platform as search_v3 {
        name "Protocols Search"
        display_name "Vertex AI Search"
      }
    }
  }
}

paths {
  usuarios_v3 -right-> lb_v3 : "HTTPS"
  lb_v3 -down-> waf_v3
  waf_v3 -right-> portal_v3
  portal_v3 .down.> sa_portal_v3

  portal_v3 -right-> vpc_v3
  vpc_v3 -down-> db_v3
  sa_portal_v3 .right.> pdf_v3

  portal_v3 -right-> agent_v3
  agent_v3 .down.> sa_agent_v3
  sa_agent_v3 .down.> registry_v3

  # Accesos limpios del Agente IA -> Orders DB y Seguridad IA/RAG
  db_v3 <-down- agent_v3
  agent_v3 -right-> guardrails_v3
  guardrails_v3 -down-> gemini_v3
  guardrails_v3 .down.> logs_v3
  gemini_v3 -down-> search_v3

  # Auditoria punteada hacia Monitoreo (LB, Cloud Armor, Web Portal y Clinical Agent)
  lb_v3 .right.> logs_v3
  waf_v3 .right.> logs_v3
  portal_v3 .down.> logs_v3
  logs_v3 <.right. agent_v3

  sa_portal_v3 (-down->) logs_v3
  db_v3 (-down->) pdf_v3
  pdf_v3 (-down->) agent_v3
}
