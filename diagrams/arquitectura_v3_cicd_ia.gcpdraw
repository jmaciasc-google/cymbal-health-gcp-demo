# Cymbal Health v3 Completa: Gemini Enterprise, CI/CD, Agente IA Seguro y Cloud Security

meta {
  title "Cymbal Health: Arquitectura Completa + Gemini Enterprise, Agente IA y Cloud Security"
}

elements {
  group linktic_team {
    name "Equipo Linktic"
    background_color "#F8F9FA"

    card users as admin_linktic {
      name "Usuarios Internos"
      display_name "Areas de Negocio"
    }

    card users as dev_linktic {
      name "Developers"
      display_name "Ingenieria"
    }
  }

  group third_party_scm {
    name "Codigo Fuente"
    background_color "#F8F9FA"

    card git as github_repo {
      name "GitHub"
      display_name "Repositorios Git"
      icon_url "https://drive.google.com/file/d/1Cvbpe0927e_cCyfKIvfvlwZmvcd5Kngn/view"
    }
  }

  group external_clients {
    name "Acceso Publico"
    background_color "#F8F9FA"

    card laptop_and_phone as usuarios_v3 {
      name "Usuarios Externos"
      display_name "Navegador HTTPS"
    }
  }

  gcp {
    group ideacion_codigo {
      name "Herramientas de IA Interna"
      background_color "#E8F0FE"

      card vertex_ai as gemini_ent {
        name "Gemini Enterprise"
        display_name "Contexto Empresarial"
      }
      card laptop as agy_pc {
        name "Antigravity"
        display_name "Subscripcion de GE"
      }
    }

    group cicd_gate {
      name "CI/CD y Seguridad"
      background_color "#FEF7E0"

      card build as cloud_build {
        name "Cloud Build"
        display_name "Pipeline CI/CD"
      }
      card security_command_center as wiz_code {
        name "Wiz Code"
        display_name "Seguridad CI/CD"
      }
      card ai_platform as codemender {
        name "CodeMender"
        display_name "Sandbox AppSec IA"
      }
      card artifact_registry as art_reg {
        name "Artifact Registry"
        display_name "Contenedores"
      }
    }

    group perimetro_v3 {
      name "Perimetro Global"
      background_color "#E8F0FE"

      card load_balancer as lb_v3 {
        name "Load Balancer"
        display_name "HTTPS Global"
      }
      card armor as waf_v3 {
        name "Cloud Armor"
        display_name "WAF OWASP"
      }
    }

    card gmail as gmail_ws {
      name "Gmail"
      display_name "Correos"
    }

    card drive as drive_ws {
      name "Google Drive"
      display_name "Documentos"
    }

    group app_v3 {
      name "Aplicacion"
      background_color "#E6F4EA"

      stacked_card run as portal_v3 {
        name "Web Portal"
        display_name "Cloud Run"
      }
      card iam as sa_portal_v3 {
        name "Service Account"
        display_name "Least Privilege"
      }
    }

    group datos_v3 {
      name "Red y Datos Privados"
      background_color "#FEF7E0"

      card vpc as vpc_v3 {
        name "Private VPC"
        display_name "Red Aislada"
      }
      card sql as db_v3 {
        name "Orders DB"
        display_name "Cloud SQL PostgreSQL"
      }
      card storage as pdf_v3 {
        name "PDF Storage"
        display_name "Cloud Storage"
      }
    }

    group agent_layer_v3 {
      name "Agente IA Interno"
      background_color "#E8F0FE"

      stacked_card run as agent_v3 {
        name "Clinical Agent"
        display_name "Cloud Run + ADK"
      }
      card iam as sa_agent_v3 {
        name "Agent Identity"
        display_name "Least Privilege"
      }
      card ai_hub as registry_v3 {
        name "Agent Registry"
        display_name "Catalogo IA"
      }
    }

    group ops_v3 {
      name "Monitoreo"
      background_color "#F3E8FD"

      card logging as logs_v3 {
        name "Audit Logs"
        display_name "Cloud Logging (GCP)"
      }
    }

    group ai_security_v3 {
      name "Seguridad IA y Conocimiento"
      background_color "#FEF7E0"

      card data_loss_prevention as guardrails_v3 {
        name "Model Armor + DLP"
        display_name "Anti-Injection y PII"
      }
      card vertex_ai as gemini_v3 {
        name "Gemini Model"
        display_name "Vertex AI"
      }
      card ai_platform as search_v3 {
        name "Protocols Search"
        display_name "Vertex AI Search"
      }
    }

    group obs_sec_v3 {
      name "Observabilidad y Seguridad"
      background_color "#FCE8E6"

      card security_command_center as google_secops {
        name "Google SecOps"
        display_name "SIEM y SOAR"
      }
      card asset_inventory as wiz_cloud {
        name "Wiz"
        display_name "Wiz Cloud + Defend"
      }
    }

    card apis_services as gcp_api {
      name "Google Cloud API"
      display_name "Inventario y Control"
    }
  }
}

paths {
  # 1. Equipo Linktic, GitHub y Acceso Publico -> Google Cloud
  admin_linktic -right-> gemini_ent
  dev_linktic .right.> gemini_ent
  dev_linktic -right-> agy_pc
  github_repo <-right- agy_pc
  github_repo -right-> cloud_build

  # 2. Pipeline CI/CD 2x2
  cloud_build -down-> wiz_code
  cloud_build (-right->) art_reg
  wiz_code -right-> codemender
  codemender -up-> art_reg

  # 3. Trafico Publico y Workspace Context
  usuarios_v3 -right-> lb_v3 : "HTTPS"
  lb_v3 -down-> waf_v3
  gemini_ent <-right- gmail_ws
  gemini_ent <-right- drive_ws

  # 4. Despliegue y Perimetro -> Aplicacion
  art_reg -right-> portal_v3
  waf_v3 -up-> portal_v3
  portal_v3 .down.> sa_portal_v3

  # 5. Aplicacion -> Red/Datos + Agente IA Interno
  portal_v3 -right-> vpc_v3
  vpc_v3 -down-> db_v3
  sa_portal_v3 .right.> pdf_v3

  portal_v3 -right-> agent_v3
  agent_v3 .down.> sa_agent_v3
  sa_agent_v3 .down.> registry_v3

  # 6. Agente IA -> Orders DB y Seguridad IA/RAG
  db_v3 <-down- agent_v3
  agent_v3 -right-> guardrails_v3
  guardrails_v3 -down-> gemini_v3
  gemini_v3 -down-> search_v3

  # 7. Auditoria punteada hacia Monitoreo (en la base de Col 4!)
  lb_v3 .down.> logs_v3
  waf_v3 .down.> logs_v3
  portal_v3 .down.> logs_v3
  agent_v3 .down.> logs_v3
  guardrails_v3 .right.> logs_v3

  # 8. Monitoreo y Google Cloud API -> Observabilidad y Seguridad (adyacente en Col 5!)
  logs_v3 -right-> google_secops
  logs_v3 -right-> wiz_cloud
  wiz_cloud <-down- gcp_api
  google_secops <.down. gcp_api

  # 9. Orden vertical explicito por columna
  admin_linktic (-down->) dev_linktic
  dev_linktic (-down->) github_repo
  github_repo (-down->) usuarios_v3

  gemini_ent (-down->) agy_pc
  agy_pc (-down->) cloud_build
  wiz_code (-down->) lb_v3

  gmail_ws (-down->) drive_ws
  drive_ws (-down->) portal_v3

  db_v3 (-down->) pdf_v3
  pdf_v3 (-down->) agent_v3
  registry_v3 (-down->) logs_v3

  search_v3 (-down->) google_secops
  google_secops (-down->) wiz_cloud
  wiz_cloud (-down->) gcp_api
}
